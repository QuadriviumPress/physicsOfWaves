{
  "name": "physics-of-waves",
  "private": true,
  "description": "MyST Markdown edition of The Physics of Waves by Howard Georgi",
  "scripts": {
    "start": "myst start",
    "build": "myst build --html && node scripts/setup-pwa.mjs",
    "verify": "python3 scripts/verify_book.py",
    "check": "npm run verify && myst build --html --strict --check-links",
    "convert": "sh scripts/build.sh",
    "crawl": "python3 scripts/crawl_libretexts.py"
  },
  "devDependencies": {
    "mystmd": "1.10.1",
    "sharp": "0.35.4",
    "yaml": "2.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
